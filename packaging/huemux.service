# Example systemd --user unit for running huemux as a persistent
# background service instead of a foreground terminal session.
#
# This is an example, not an installer — nothing installs it automatically.
# To use it:
#
#   mkdir -p ~/.config/systemd/user
#   cp packaging/huemux.service ~/.config/systemd/user/
#   # edit ExecStart below if your binary lives somewhere other than ~/bin/
#   systemctl --user daemon-reload
#   systemctl --user enable --now huemux.service
#
# Because huemux opens a browser tab on start (best-effort) and prints a
# CLI status block, running it under systemd loses both — that's expected.
# Watch it with `journalctl --user -u huemux -f` instead, and open
# http://127.0.0.1:7654 manually.

[Unit]
Description=HueMux — Philips Hue screen sync and light control
After=network.target

[Service]
Type=simple
ExecStart=%h/bin/huemux
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
