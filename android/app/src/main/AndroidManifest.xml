<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Reaching the Hue bridge on the LAN. The server itself is loopback,
         but the Go code inside it makes real network calls. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Bridge discovery uses mDNS/SSDP, which needs a multicast lock; these
         are what MulticastLock requires. Discovery is the single most likely
         Android-specific failure (see plans/02), and manual IP entry is the
         fallback if a given ROM filters multicast anyway. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Screen sync. FOREGROUND_SERVICE_MEDIA_PROJECTION is required from
         Android 14; without it startForeground throws at runtime rather than
         failing a check at install time. POST_NOTIFICATIONS is needed from 13
         for the ongoing capture notification the service is obliged to show. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Music reactivity: the WebView's getUserMedia for the microphone.
         Dangerous permission, so it is also requested at runtime (see
         MainActivity's micPermissionLauncher). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.HueMux">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- foregroundServiceType is mandatory from Android 10 for a service
             that holds a MediaProjection, and must match the type passed to
             startForeground(). -->
        <service
            android:name=".ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
