{
  "version": 1,
  "name": "Chill Ambient",
  "description": "Slow color cycling with smooth transitions; brightness follows the bass gently",
  "nodes": [
    { "id": "src", "type": "mic_capture", "params": {} },
    { "id": "bands", "type": "freq_bands", "params": {} },
    { "id": "energy_smooth", "type": "smoother", "params": { "attack_ms": 800, "release_ms": 2000 } },
    { "id": "bass_drive", "type": "brightness_energy", "params": { "curve": "lin", "min": 0.12, "max": 0.7 } },
    { "id": "lfo", "type": "lfo", "params": { "waveform": "sin", "frequency": 0.08 } },
    { "id": "color", "type": "color_map_energy", "params": { "palette": ["#1B2A4A", "#2E4A62", "#6B5B8A", "#2E4A62", "#1B2A4A"] } },
    { "id": "lights", "type": "all_lights", "params": {} },
    { "id": "reactivity", "type": "reactivity_effect", "params": { "reactivity": 45 } },
    { "id": "saturation", "type": "saturation_effect", "params": { "saturation": 130 } }
  ],
  "edges": [
    { "from": "src", "to": "bands" },
    { "from": "bands", "out_port": "bass", "to": "energy_smooth", "in_port": "in" },
    { "from": "energy_smooth", "out_port": "out", "to": "bass_drive", "in_port": "energy" },
    { "from": "lfo", "out_port": "out", "to": "color", "in_port": "energy" },
    { "from": "color", "out_port": "r", "to": "lights", "in_port": "r" },
    { "from": "color", "out_port": "g", "to": "lights", "in_port": "g" },
    { "from": "color", "out_port": "b", "to": "lights", "in_port": "b" },
    { "from": "bass_drive", "out_port": "out", "to": "lights", "in_port": "in" }
  ]
}
