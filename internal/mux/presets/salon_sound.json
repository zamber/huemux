{
  "version": 1,
  "name": "Salon sound bars",
  "room": "Salon",
  "master": { "brightness": 0.9 },
  "lanes": [
    {
      "id": "bass",
      "name": "Bass",
      "source": { "type": "sound", "params": { "band": "bass", "gain": 1.6, "smoothing": 0.6 } },
      "effect": { "type": "pulse", "params": { "color": "#FF3B30", "min": 0.05, "max": 1, "curve": "exp" } },
      "blend": "replace",
      "level": 1
    },
    {
      "id": "treble",
      "name": "Treble sparkle",
      "source": { "type": "sound", "params": { "band": "treble", "gain": 1.8, "smoothing": 0.4 } },
      "effect": { "type": "sparkle", "params": { "color": "#7C4DFF", "density": 0.3, "decay": 1.2, "speed": 1.6 } },
      "blend": "add",
      "level": 0.7
    }
  ],
  "output": { "hz": 4, "transition_ms": 180 }
}
